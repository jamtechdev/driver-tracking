# Mapbox tokens — copy once, never commit .env
#
#   cp .env.example .env
#   # paste pk + sk tokens
#   npm run setup:mapbox
#
# After git pull on any machine:
#   npm run setup:mapbox   (or npm install — runs sync if .env exists)

MAPBOX_ACCESS_TOKEN=pk.YOUR_MAPBOX_PUBLIC_TOKEN
MAPBOX_DOWNLOADS_TOKEN=sk.YOUR_MAPBOX_SECRET_DOWNLOADS_TOKEN

GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
API_BASE_URL=https://api.peaktransit.com/v5/index.php
